%rec: Badge
%doc: 88x31 badge for rotating display on pnppl.cc.
# img: filename minus .gif and /public/badges/
# alt: alt text
# href: target to link to, defaults to about
%allowed: img href alt
%mandatory: img alt
%unique: img href alt
%singular: img
%singular: alt
%key: img
%sort: img
%type: img,href,alt line

