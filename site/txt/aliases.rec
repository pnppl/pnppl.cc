%rec: Alias
%doc: Alias(es) for a page on pnppl.cc.
%allowed: page alias nodefault
%mandatory: page
%unique: page nodefault
%singular: page
%singular: alias
%key: page
%sort: page
%type: page,alias line
# don't mention title
%type: nodefault bool
# no spaces in page filename
%constraint: !(page ~ ' ')
# no extension in page filename
%constraint: !(page ~ '\.[a-z]{1,4}$')
# no capitals in alias
%constraint: !(alias ~ '[A-Z]')

page: 2026-01-01_possessor
alias: possessor

